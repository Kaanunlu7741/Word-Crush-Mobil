<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:background="@drawable/bg_modern_arkaplan">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="24dp"
        android:clipChildren="false"
        android:clipToPadding="false">

        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/btnKullaniciAdi"
            android:layout_width="wrap_content"
            android:layout_height="50dp"
            android:background="@drawable/bg_panel_modern"
            android:paddingStart="20dp"
            android:paddingEnd="20dp"
            android:elevation="4dp"
            android:text="👤 Oyuncu"
            android:textAllCaps="false"
            android:textColor="#F1C40F"
            android:textSize="16sp"
            android:textStyle="bold"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintStart_toStartOf="parent" />

        <LinearLayout
            android:id="@+id/llMenuHeader"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="center"
            app:layout_constraintTop_toBottomOf="@+id/btnKullaniciAdi"
            app:layout_constraintBottom_toTopOf="@+id/llButonlar"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintVertical_chainStyle="packed"
            android:layout_marginTop="16dp"
            android:layout_marginBottom="32dp">

            <TextView
                android:id="@+id/tvMenuTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="WORD"
                android:textColor="#FFFFFF"
                android:textSize="@dimen/menu_title_text_size"
                android:textStyle="bold"
                android:letterSpacing="0.1"
                android:shadowColor="#000000"
                android:shadowDx="4"
                android:shadowDy="4"
                android:shadowRadius="10" />

            <TextView
                android:id="@+id/tvMenuSubTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="CRUSH"
                android:textColor="#F1C40F"
                android:textSize="@dimen/menu_subtitle_text_size"
                android:textStyle="bold"
                android:letterSpacing="0.1"
                android:layout_marginTop="-8dp"
                android:shadowColor="#000000"
                android:shadowDx="4"
                android:shadowDy="4"
                android:shadowRadius="10" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/llButonlar"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:clipChildren="false"
            android:clipToPadding="false"
            android:padding="16dp"
            app:layout_constraintTop_toBottomOf="@+id/llMenuHeader"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintWidth_max="450dp">

            <androidx.appcompat.widget.AppCompatButton
                android:id="@+id/btnYeniOyun"
                android:layout_width="match_parent"
                android:layout_height="@dimen/button_height"
                android:layout_marginBottom="16dp"
                android:background="@drawable/btn_modern_yesil"
                android:elevation="8dp"
                android:text="▶ YENİ OYUN"
                android:textColor="#FFFFFF"
                android:textSize="@dimen/button_text_size"
                android:textStyle="bold" />

            <androidx.appcompat.widget.AppCompatButton
                android:id="@+id/btnSkorTablosu"
                android:layout_width="match_parent"
                android:layout_height="@dimen/button_height"
                android:layout_marginBottom="16dp"
                android:background="@drawable/btn_modern_mor"
                android:elevation="8dp"
                android:text="🏆 SKOR TABLOSU"
                android:textColor="#FFFFFF"
                android:textSize="@dimen/button_text_size"
                android:textStyle="bold" />

            <androidx.appcompat.widget.AppCompatButton
                android:id="@+id/btnMarket"
                android:layout_width="match_parent"
                android:layout_height="@dimen/button_height"
                android:layout_marginBottom="16dp"
                android:background="@drawable/btn_modern_turuncu"
                android:elevation="8dp"
                android:text="🛒 MARKET"
                android:textColor="#FFFFFF"
                android:textSize="@dimen/button_text_size"
                android:textStyle="bold" />

            <androidx.appcompat.widget.AppCompatButton
                android:id="@+id/btnNasilOynanir"
                android:layout_width="match_parent"
                android:layout_height="@dimen/button_height"
                android:background="@drawable/btn_modern_yesil"
                android:elevation="8dp"
                android:text="❓ NASIL OYNANIR?"
                android:textColor="#FFFFFF"
                android:textSize="@dimen/button_text_size"
                android:textStyle="bold" />
        </LinearLayout>

    </androidx.constraintlayout.widget.ConstraintLayout>
</ScrollView>
