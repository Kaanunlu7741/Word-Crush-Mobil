<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_modern_arkaplan"
    android:clipChildren="false"
    android:clipToPadding="false"
    android:padding="16dp">

    <androidx.appcompat.widget.AppCompatButton
        android:id="@+id/btnAnaMenuyeDon"
        android:layout_width="wrap_content"
        android:layout_height="35dp"
        android:background="@drawable/bg_panel_modern"
        android:text="🏠 ANA MENÜ"
        android:textColor="#F1C40F"
        android:textSize="11sp"
        android:textStyle="bold"
        android:paddingStart="10dp"
        android:paddingEnd="10dp"
        android:elevation="4dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <LinearLayout
        android:id="@+id/llStats"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:weightSum="3"
        app:layout_constraintTop_toBottomOf="@+id/btnAnaMenuyeDon"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginEnd="4dp"
            android:background="@drawable/bg_panel_modern"
            android:gravity="center"
            android:orientation="vertical"
            android:padding="10dp">
            <TextView android:layout_width="wrap_content" android:text="SKOR" android:textColor="#BDC3C7" android:textSize="11sp" android:textStyle="bold" android:layout_height="wrap_content"/>
            <TextView android:id="@+id/tvSkor" android:layout_width="wrap_content" android:text="0" android:textColor="#F1C40F" android:textSize="18sp" android:textStyle="bold" android:layout_height="wrap_content"/>
        </LinearLayout>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="4dp"
            android:layout_marginEnd="4dp"
            android:background="@drawable/bg_panel_modern"
            android:gravity="center"
            android:orientation="vertical"
            android:padding="10dp">
            <TextView android:layout_width="wrap_content" android:text="HAMLE" android:textColor="#BDC3C7" android:textSize="11sp" android:textStyle="bold" android:layout_height="wrap_content"/>
            <TextView android:id="@+id/tvHamle" android:layout_width="wrap_content" android:text="25" android:textColor="#E74C3C" android:textSize="18sp" android:textStyle="bold" android:layout_height="wrap_content"/>
        </LinearLayout>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="4dp"
            android:background="@drawable/bg_panel_modern"
            android:gravity="center"
            android:orientation="vertical"
            android:padding="10dp">
            <TextView android:layout_width="wrap_content" android:text="SÜRE" android:textColor="#BDC3C7" android:textSize="11sp" android:textStyle="bold" android:layout_height="wrap_content"/>
            <TextView android:id="@+id/tvSure" android:layout_width="wrap_content" android:text="⏱️ 00:00" android:textColor="#FFFFFF" android:textSize="18sp" android:textStyle="bold" android:layout_height="wrap_content"/>
        </LinearLayout>
    </LinearLayout>

    <LinearLayout
        android:id="@+id/llHedef"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:gravity="center"
        android:orientation="horizontal"
        app:layout_constraintTop_toBottomOf="@+id/llStats"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <TextView
            android:id="@+id/tvHedefSayaci"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_panel_modern"
            android:paddingStart="30dp"
            android:paddingEnd="30dp"
            android:paddingTop="10dp"
            android:paddingBottom="10dp"
            android:text="🎯 Kalan Hedef: 0"
            android:textColor="#F1C40F"
            android:textSize="18sp"
            android:textStyle="bold"
            android:elevation="4dp" />
    </LinearLayout>

    <TextView
        android:id="@+id/tvSecilenKelime"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:text="Kelime seçin..."
        android:textColor="#FFFFFF"
        android:textSize="24sp"
        android:textStyle="bold"
        app:layout_constraintTop_toBottomOf="@+id/llHedef"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <TextView
        android:id="@+id/tvIpucu"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:text=""
        android:textColor="#F1C40F"
        android:textSize="16sp"
        android:textStyle="bold|italic"
        android:visibility="gone"
        app:layout_constraintTop_toBottomOf="@+id/tvSecilenKelime"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <GridLayout
        android:id="@+id/gridLayout"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_panel_modern"
        android:padding="8dp"
        app:layout_constraintTop_toBottomOf="@+id/tvIpucu"
        app:layout_constraintBottom_toTopOf="@+id/btnOyunIciMarket"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <LinearLayout
        android:id="@+id/btnOyunIciMarket"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:minWidth="140dp"
        android:background="@drawable/btn_modern_turuncu"
        android:gravity="center"
        android:orientation="horizontal"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:paddingTop="8dp"
        android:paddingBottom="8dp"
        android:clickable="true"
        android:focusable="true"
        android:elevation="6dp"
        android:layout_marginBottom="12dp"
        app:layout_constraintBottom_toTopOf="@+id/hsvJokerler"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <TextView
            android:layout_width="wrap_content"
            android:text="MARKET: "
            android:textColor="#FFFFFF"
            android:textSize="14sp"
            android:textStyle="bold"
            android:layout_height="wrap_content"/>

        <TextView
            android:id="@+id/tvAltin"
            android:layout_width="wrap_content"
            android:text="0 🪙"
            android:textColor="#FFFFFF"
            android:textSize="16sp"
            android:textStyle="bold"
            android:maxLines="1"
            android:ellipsize="end"
            android:layout_height="wrap_content"/>
    </LinearLayout>

    <HorizontalScrollView
        android:id="@+id/hsvJokerler"
        android:layout_width="0dp"
        android:layout_height="100dp"
        android:clipChildren="false"
        android:clipToPadding="false"
        android:scrollbars="none"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingStart="32dp"
            android:paddingEnd="32dp"
            android:clipChildren="false"
            android:clipToPadding="false">

            <androidx.appcompat.widget.AppCompatButton
                android:id="@+id/btnOyunBalik"
                android:layout_width="80dp"
                android:layout_height="60dp"
                android:layout_marginEnd="8dp"
                android:background="@drawable/btn_modern_yesil"
                android:text="🐟 x0"
                android:textColor="#FFFFFF"
                android:textStyle="bold"/>

            <androidx.appcompat.widget.AppCompatButton
                android:id="@+id/btnOyunIsinKilici"
                android:layout_width="80dp"
                android:layout_height="60dp"
                android:layout_marginEnd="8dp"
                android:background="@drawable/btn_modern_mor"
                android:text="⚔️ x0"
                android:textColor="#FFFFFF"
                android:textStyle="bold"/>

            <androidx.appcompat.widget.AppCompatButton
                android:id="@+id/btnOyunKeskinNisanci"
                android:layout_width="80dp"
                android:layout_height="60dp"
                android:layout_marginEnd="8dp"
                android:background="@drawable/btn_modern_turuncu"
                android:text="🎯 x0"
                android:textColor="#FFFFFF"
                android:textStyle="bold"/>

            <androidx.appcompat.widget.AppCompatButton
                android:id="@+id/btnOyunDegistirme"
                android:layout_width="80dp"
                android:layout_height="60dp"
                android:layout_marginEnd="8dp"
                android:background="@drawable/btn_modern_yesil"
                android:text="🔄 x0"
                android:textColor="#FFFFFF"
                android:textStyle="bold"/>

            <androidx.appcompat.widget.AppCompatButton
                android:id="@+id/btnOyunKaristirma"
                android:layout_width="80dp"
                android:layout_height="60dp"
                android:layout_marginEnd="8dp"
                android:background="@drawable/btn_modern_mor"
                android:text="🔀 x0"
                android:textColor="#FFFFFF"
                android:textStyle="bold"/>

            <androidx.appcompat.widget.AppCompatButton
                android:id="@+id/btnOyunParti"
                android:layout_width="80dp"
                android:layout_height="60dp"
                android:layout_marginEnd="8dp"
                android:background="@drawable/btn_modern_turuncu"
                android:text="🎉 x0"
                android:textColor="#FFFFFF"
                android:textStyle="bold"/>

            <androidx.appcompat.widget.AppCompatButton
                android:id="@+id/btnOyunIpucu"
                android:layout_width="80dp"
                android:layout_height="60dp"
                android:background="@drawable/btn_modern_yesil"
                android:text="💡 x0"
                android:textColor="#FFFFFF"
                android:textStyle="bold"/>

        </LinearLayout>
    </HorizontalScrollView>
</androidx.constraintlayout.widget.ConstraintLayout>
