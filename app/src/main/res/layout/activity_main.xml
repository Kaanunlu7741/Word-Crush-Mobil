<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:background="@drawable/bg_modern_arkaplan">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="32dp"
        android:clipChildren="false"
        android:clipToPadding="false">

        <LinearLayout
            android:id="@+id/llHeader"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="center"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toTopOf="@+id/llInputContainer"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintVertical_chainStyle="packed"
            android:layout_marginBottom="@dimen/header_margin_bottom">

            <TextView
                android:id="@+id/tvTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="WORD"
                android:textColor="#FFFFFF"
                android:textSize="@dimen/title_text_size"
                android:textStyle="bold"
                android:letterSpacing="0.1"
                android:shadowColor="#000000"
                android:shadowDx="4"
                android:shadowDy="4"
                android:shadowRadius="12" />

            <TextView
                android:id="@+id/tvSubTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="CRUSH"
                android:textColor="#F1C40F"
                android:textSize="@dimen/subtitle_text_size"
                android:textStyle="bold"
                android:letterSpacing="0.1"
                android:layout_marginTop="-10dp"
                android:shadowColor="#000000"
                android:shadowDx="4"
                android:shadowDy="4"
                android:shadowRadius="12" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/llInputContainer"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_panel_modern"
            android:orientation="vertical"
            android:padding="@dimen/panel_padding"
            android:elevation="12dp"
            app:layout_constraintTop_toBottomOf="@+id/llHeader"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintWidth_max="500dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Hemen Kaydol"
                android:textColor="#BDC3C7"
                android:textSize="14sp"
                android:textStyle="bold"
                android:layout_marginBottom="12dp"
                android:textAllCaps="true"/>

            <EditText
                android:id="@+id/etKullaniciAdi"
                android:layout_width="match_parent"
                android:layout_height="@dimen/input_height"
                android:layout_marginBottom="24dp"
                android:background="@drawable/bg_edittext_modern"
                android:hint="Kullanıcı Adı"
                android:padding="16dp"
                android:textColor="#2C3E50"
                android:textColorHint="#95A5A6"
                android:textSize="@dimen/input_text_size"
                android:importantForAutofill="no"
                android:inputType="textVisiblePassword|textNoSuggestions" />

            <androidx.appcompat.widget.AppCompatButton
                android:id="@+id/btnGiris"
                android:layout_width="match_parent"
                android:layout_height="@dimen/button_height"
                android:background="@drawable/btn_modern_yesil"
                android:elevation="8dp"
                android:text="OYUNA BAŞLA"
                android:textColor="#FFFFFF"
                android:textSize="@dimen/button_text_size"
                android:textStyle="bold" />
        </LinearLayout>

    </androidx.constraintlayout.widget.ConstraintLayout>
</ScrollView>
